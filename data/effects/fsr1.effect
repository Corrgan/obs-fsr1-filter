// FSR 1 (FidelityFX Super Resolution 1.0) für OBS Studio
// Portierung von EASU und RCAS aus AMDs ffx_fsr1.h (MIT-Lizenz),
// Copyright (c) 2021 Advanced Micro Devices, Inc. All rights reserved.
//
// Reine FP32-Variante. Der Gather4-Zugriff des Originals ist durch
// einzelne Punkt-Abtastungen ersetzt, damit der Effect auf allen
// OBS-Backends (OpenGL, D3D11, Metal) läuft.
//
// Technique "EASU": Hochskalieren (Edge-Adaptive Spatial Upsampling)
// Technique "RCAS": Schärfen (Robust Contrast Adaptive Sharpening)

uniform float4x4 ViewProj;
uniform texture2d image;

// EASU
uniform float2 input_size;   // Größe des Quellbildes in Pixeln
uniform float2 output_size;  // Größe des Zielbildes in Pixeln

// RCAS
uniform float rcas_sharp;    // exp2(-Schärfe in Blenden), 1.0 = maximal
uniform float rcas_denoise;  // 1.0 = Rauschunterdrückung an, 0.0 = aus

sampler_state point_clamp {
	Filter    = Point;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// ---------------------------------------------------------------------
// EASU
// ---------------------------------------------------------------------

float3 FetchTexel(float2 texel)
{
	return image.Sample(point_clamp, (texel + 0.5) / input_size).rgb;
}

float LumaTimes2(float3 c)
{
	return c.b * 0.5 + (c.r * 0.5 + c.g);
}

// Akkumuliert Richtung und Länge für eine der vier bilinearen Ecken.
//    a
//  b c d
//    e
void EasuSet(inout float2 dir, inout float len, float2 pp,
	bool biS, bool biT, bool biU, bool biV,
	float lA, float lB, float lC, float lD, float lE)
{
	float w = 0.0;
	if (biS) w = (1.0 - pp.x) * (1.0 - pp.y);
	if (biT) w = pp.x * (1.0 - pp.y);
	if (biU) w = (1.0 - pp.x) * pp.y;
	if (biV) w = pp.x * pp.y;

	float dc = lD - lC;
	float cb = lC - lB;
	float lenX = max(abs(dc), abs(cb));
	lenX = 1.0 / max(lenX, 0.00000001);
	float dirX = lD - lB;
	dir.x += dirX * w;
	lenX = saturate(abs(dirX) * lenX);
	lenX *= lenX;
	len += lenX * w;

	float ec = lE - lC;
	float ca = lC - lA;
	float lenY = max(abs(ec), abs(ca));
	lenY = 1.0 / max(lenY, 0.00000001);
	float dirY = lE - lA;
	dir.y += dirY * w;
	lenY = saturate(abs(dirY) * lenY);
	lenY *= lenY;
	len += lenY * w;
}

void EasuTap(inout float3 aC, inout float aW, float2 off, float2 dir,
	float2 len, float lob, float clp, float3 c)
{
	// Offset an der Kantenrichtung ausrichten.
	float2 v;
	v.x = (off.x * dir.x) + (off.y * dir.y);
	v.y = (off.x * (-dir.y)) + (off.y * dir.x);
	// Anisotropie.
	v *= len;
	// Abstand^2, am Fensterrand begrenzt.
	float d2 = v.x * v.x + v.y * v.y;
	d2 = min(d2, clp);
	// Lanczos2-Näherung ohne sin()/sqrt().
	float wB = 2.0 / 5.0 * d2 - 1.0;
	float wA = lob * d2 - 1.0;
	wB *= wB;
	wA *= wA;
	wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
	float w = wB * wA;
	aC += c * w;
	aW += w;
}

float4 PSEasu(VertData v_in) : TARGET
{
	// Ausgabepixel (ganzzahlig) -> Position im Quellbild.
	float2 ip = floor(v_in.uv * output_size);
	float2 scale = input_size / output_size;
	float2 pp = ip * scale + (0.5 * scale - 0.5);
	float2 fp = floor(pp);
	pp -= fp;

	// 12 Abtastungen um fp:
	//    b c
	//  e f g h
	//  i j k l
	//    n o
	float3 b = FetchTexel(fp + float2( 0.0, -1.0));
	float3 c = FetchTexel(fp + float2( 1.0, -1.0));
	float3 e = FetchTexel(fp + float2(-1.0,  0.0));
	float3 f = FetchTexel(fp + float2( 0.0,  0.0));
	float3 g = FetchTexel(fp + float2( 1.0,  0.0));
	float3 h = FetchTexel(fp + float2( 2.0,  0.0));
	float3 i = FetchTexel(fp + float2(-1.0,  1.0));
	float3 j = FetchTexel(fp + float2( 0.0,  1.0));
	float3 k = FetchTexel(fp + float2( 1.0,  1.0));
	float3 l = FetchTexel(fp + float2( 2.0,  1.0));
	float3 n = FetchTexel(fp + float2( 0.0,  2.0));
	float3 o = FetchTexel(fp + float2( 1.0,  2.0));

	float bL = LumaTimes2(b);
	float cL = LumaTimes2(c);
	float eL = LumaTimes2(e);
	float fL = LumaTimes2(f);
	float gL = LumaTimes2(g);
	float hL = LumaTimes2(h);
	float iL = LumaTimes2(i);
	float jL = LumaTimes2(j);
	float kL = LumaTimes2(k);
	float lL = LumaTimes2(l);
	float nL = LumaTimes2(n);
	float oL = LumaTimes2(o);

	// Richtung und Kantenlänge aus den vier bilinearen Ecken.
	float2 dir = float2(0.0, 0.0);
	float len = 0.0;
	EasuSet(dir, len, pp, true,  false, false, false, bL, eL, fL, gL, jL);
	EasuSet(dir, len, pp, false, true,  false, false, cL, fL, gL, hL, kL);
	EasuSet(dir, len, pp, false, false, true,  false, fL, iL, jL, kL, nL);
	EasuSet(dir, len, pp, false, false, false, true,  gL, jL, kL, lL, oL);

	// Richtung normalisieren, nahe Null aufräumen.
	float2 dir2 = dir * dir;
	float dirR = dir2.x + dir2.y;
	if (dirR < (1.0 / 32768.0)) {
		// Keine erkennbare Kante: waagerechte Richtung annehmen.
		dir.x = 1.0;
		dirR = 1.0;
	} else {
		dirR = rsqrt(dirR);
	}
	dir *= float2(dirR, dirR);

	// Länge von {0..2} auf {0..1}, mit Quadrat formen.
	len = len * 0.5;
	len *= len;

	// Kernel strecken: 1.0 waagerecht/senkrecht, sqrt(2) diagonal.
	float stretch = (dir.x * dir.x + dir.y * dir.y) / max(max(abs(dir.x), abs(dir.y)), 0.00000001);

	// Anisotrope Länge nach der Rotation.
	float2 len2 = float2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);

	// Fensterverschiebung abhängig von der Kantenstärke.
	float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
	float clp = 1.0 / lob;

	// Min/Max der vier nächsten Pixel (f, g, j, k) für das Dering.
	float3 min4 = min(min(f, g), min(j, k));
	float3 max4 = max(max(f, g), max(j, k));

	float3 aC = float3(0.0, 0.0, 0.0);
	float aW = 0.0;
	EasuTap(aC, aW, float2( 0.0, -1.0) - pp, dir, len2, lob, clp, b);
	EasuTap(aC, aW, float2( 1.0, -1.0) - pp, dir, len2, lob, clp, c);
	EasuTap(aC, aW, float2(-1.0,  1.0) - pp, dir, len2, lob, clp, i);
	EasuTap(aC, aW, float2( 0.0,  1.0) - pp, dir, len2, lob, clp, j);
	EasuTap(aC, aW, float2( 0.0,  0.0) - pp, dir, len2, lob, clp, f);
	EasuTap(aC, aW, float2(-1.0,  0.0) - pp, dir, len2, lob, clp, e);
	EasuTap(aC, aW, float2( 1.0,  1.0) - pp, dir, len2, lob, clp, k);
	EasuTap(aC, aW, float2( 2.0,  1.0) - pp, dir, len2, lob, clp, l);
	EasuTap(aC, aW, float2( 2.0,  0.0) - pp, dir, len2, lob, clp, h);
	EasuTap(aC, aW, float2( 1.0,  0.0) - pp, dir, len2, lob, clp, g);
	EasuTap(aC, aW, float2( 1.0,  2.0) - pp, dir, len2, lob, clp, o);
	EasuTap(aC, aW, float2( 0.0,  2.0) - pp, dir, len2, lob, clp, n);

	// Normalisieren und Dering.
	float3 pix = min(max4, max(min4, aC / aW));
	return float4(pix, 1.0);
}

// ---------------------------------------------------------------------
// RCAS (arbeitet auf der Ausgabeauflösung, 1:1 pro Pixel)
// ---------------------------------------------------------------------

// Begrenzung des Schärfe-Lobes: 0.25 - 1/16 = 0.1875
// (fest eingetragen statt als Makro, da OBS' Präprozessor Klammern nach dem Namen falsch liest)

float3 RcasFetch(float2 px)
{
	// "image" ist hier das EASU-Ergebnis in Ausgabegröße.
	return image.Sample(point_clamp, (px + 0.5) / output_size).rgb;
}

float4 PSRcas(VertData v_in) : TARGET
{
	float2 sp = floor(v_in.uv * output_size);

	float3 b = RcasFetch(sp + float2( 0.0, -1.0));
	float3 d = RcasFetch(sp + float2(-1.0,  0.0));
	float3 e = RcasFetch(sp);
	float3 f = RcasFetch(sp + float2( 1.0,  0.0));
	float3 h = RcasFetch(sp + float2( 0.0,  1.0));

	// Luma mal 2.
	float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
	float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
	float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
	float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
	float hL = h.b * 0.5 + (h.r * 0.5 + h.g);

	// Rauscherkennung.
	float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
	float lmax = max(max(max(bL, dL), eL), max(fL, hL));
	float lmin = min(min(min(bL, dL), eL), min(fL, hL));
	nz = saturate(abs(nz) / max(lmax - lmin, 0.000001));
	nz = -0.5 * nz + 1.0;

	// Min/Max des Rings.
	float3 mn4 = min(min(b, d), min(f, h));
	float3 mx4 = max(max(b, d), max(f, h));

	// Begrenzer.
	// Die Nenner werden von null weggehalten: Bei rein schwarzen (mx4 = 0) oder
	// rein weißen Flächen (mn4 = 1, z. B. ausgebrannte Lichter) entstünde sonst 0/0.
	// Wie das NaN weiterläuft, hängt vom Treiber ab (mögliche schwarze Pixel).
	// Ergebnis an diesen Stellen: lobe = 0, also keine Schärfung - wie gewollt.
	float2 peakC = float2(1.0, -4.0);
	float3 hitMin = min(mn4, e) / max(4.0 * mx4, float3(0.00003, 0.00003, 0.00003));
	float3 hitMax = (peakC.x - max(mx4, e)) / min(4.0 * mn4 + peakC.y, float3(-0.00003, -0.00003, -0.00003));
	float3 lobeRGB = max(-hitMin, hitMax);
	float lobe = max(-0.1875, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * rcas_sharp;

	// Optional: Rauschen abschwächen (hilft bei Webcams).
	lobe *= lerp(1.0, nz, rcas_denoise);

	float rcpL = 1.0 / (4.0 * lobe + 1.0);
	float3 pix = (lobe * b + lobe * d + lobe * h + lobe * f + e) * rcpL;
	return float4(saturate(pix), 1.0);
}

technique EASU
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSEasu(v_in);
	}
}

technique RCAS
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRcas(v_in);
	}
}
